# Supabase project settings (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Never put the service_role key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Messenger link of the Facebook page that receives orders
VITE_FACEBOOK_MESSENGER_URL=https://m.me/cleosushilovers

# Optional: MapTiler key for a sharper delivery map (cloud.maptiler.com).
# Leave empty to use free OpenStreetMap tiles.
VITE_MAPTILER_KEY=
